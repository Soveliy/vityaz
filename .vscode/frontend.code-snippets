{
  "Frontend HTML Include": {
    "scope": "html",
    "prefix": "fe-include",
    "description": "Insert HTML partial include",
    "body": ["@include('${1:partials}/${2:name}.html')"],
  },
  "Frontend SVG Sprite Icon": {
    "scope": "html",
    "prefix": "fe-sprite",
    "description": "Insert decorative SVG sprite icon",
    "body": [
      "<svg class=\"${1:icon}\" aria-hidden=\"true\">",
      "  <use href=\"${2:/img/sprite.svg}#${3:icon-name}\"></use>",
      "</svg>",
    ],
  },
  "Frontend SVG Sprite Accessible Icon": {
    "scope": "html",
    "prefix": "fe-sprite-a11y",
    "description": "Insert accessible SVG sprite icon",
    "body": [
      "<svg class=\"${1:icon}\" role=\"img\" aria-label=\"${2:Description}\">",
      "  <use href=\"${3:/img/sprite.svg}#${4:icon-name}\"></use>",
      "</svg>",
    ],
  },
  "Frontend Image": {
    "scope": "html",
    "prefix": "fe-img",
    "description": "Insert image with dimensions",
    "body": [
      "<img",
      "  class=\"${1:media-cover}\"",
      "  src=\"${2:/img/image.jpg}\"",
      "  width=\"${3:1200}\"",
      "  height=\"${4:800}\"",
      "  alt=\"${5:Description}\"",
      "  decoding=\"async\"",
      ">",
    ],
  },
  "Frontend Lazy Image": {
    "scope": "html",
    "prefix": "fe-img-lazy",
    "description": "Insert lazy image with dimensions",
    "body": [
      "<img",
      "  class=\"${1:media-cover}\"",
      "  src=\"${2:/img/image.jpg}\"",
      "  width=\"${3:1200}\"",
      "  height=\"${4:800}\"",
      "  alt=\"${5:Description}\"",
      "  loading=\"lazy\"",
      "  decoding=\"async\"",
      ">",
    ],
  },
  "Frontend Picture": {
    "scope": "html",
    "prefix": "fe-picture",
    "description": "Insert picture with AVIF/WebP/fallback image",
    "body": [
      "<picture>",
      "  <source srcset=\"${1:/img/image.avif}\" type=\"image/avif\">",
      "  <source srcset=\"${2:/img/image.webp}\" type=\"image/webp\">",
      "  <img",
      "    class=\"${3:media-cover}\"",
      "    src=\"${4:/img/image.jpg}\"",
      "    width=\"${5:1200}\"",
      "    height=\"${6:800}\"",
      "    alt=\"${7:Description}\"",
      "    loading=\"lazy\"",
      "    decoding=\"async\"",
      "  >",
      "</picture>",
    ],
  },
  "Frontend Ratio Picture": {
    "scope": "html",
    "prefix": "fe-ratio-picture",
    "description": "Insert fixed-ratio picture wrapper",
    "body": [
      "<div class=\"${1:ratio}\" style=\"--ratio: ${2:16 / 9};\">",
      "  <picture>",
      "    <source srcset=\"${3:/img/image.avif}\" type=\"image/avif\">",
      "    <source srcset=\"${4:/img/image.webp}\" type=\"image/webp\">",
      "    <img",
      "      class=\"${5:media-cover}\"",
      "      src=\"${6:/img/image.jpg}\"",
      "      width=\"${7:1200}\"",
      "      height=\"${8:800}\"",
      "      alt=\"${9:Description}\"",
      "      loading=\"lazy\"",
      "      decoding=\"async\"",
      "    >",
      "  </picture>",
      "</div>",
    ],
  },
  "Frontend Section": {
    "scope": "html",
    "prefix": "fe-section",
    "description": "Insert section with container",
    "body": [
      "<section class=\"${1:section}\" aria-labelledby=\"${2:section-title}\">",
      "  <div class=\"${3:container}\">",
      "    <div class=\"${1}__header\">",
      "      <p class=\"${4:text-label}\">${5:Label}</p>",
      "      <h2 class=\"${6:text-h2}\" id=\"${2}\">${7:Title}</h2>",
      "    </div>",
      "    ${0}",
      "  </div>",
      "</section>",
    ],
  },
  "Frontend Button": {
    "scope": "html",
    "prefix": "fe-btn",
    "description": "Insert button with BEM-style modifiers",
    "body": [
      "<button class=\"${1:btn} ${1}--${2:size} ${1}--${3:variant}\" type=\"${4:button}\">",
      "  ${5:Button}",
      "</button>",
    ],
  },
  "Frontend Link": {
    "scope": "html",
    "prefix": "fe-link",
    "description": "Insert link",
    "body": ["<a class=\"${1:link}\" href=\"${2:#}\">${3:Link}</a>"],
  },
  "Frontend Field": {
    "scope": "html",
    "prefix": "fe-field",
    "description": "Insert labeled field",
    "body": [
      "<label class=\"${1:field}\">",
      "  <span class=\"${1}__label\">${2:Label}</span>",
      "  <input class=\"${1}__control\" type=\"${3:text}\" name=\"${4:name}\" placeholder=\"${5:Placeholder}\">",
      "  <span class=\"${1}__hint\">${6:Hint}</span>",
      "</label>",
    ],
  },
  "Frontend Textarea Field": {
    "scope": "html",
    "prefix": "fe-textarea",
    "description": "Insert labeled textarea",
    "body": [
      "<label class=\"${1:field}\">",
      "  <span class=\"${1}__label\">${2:Label}</span>",
      "  <textarea class=\"${1}__control\" name=\"${3:name}\" placeholder=\"${4:Placeholder}\"></textarea>",
      "  <span class=\"${1}__hint\">${5:Hint}</span>",
      "</label>",
    ],
  },
  "Frontend Modal": {
    "scope": "html",
    "prefix": "fe-modal",
    "description": "Insert modal shell",
    "body": [
      "<div class=\"${1:modal}\" id=\"${2:modal}\" aria-hidden=\"true\">",
      "  <div class=\"${1}__dialog\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"${2}-title\">",
      "    <button class=\"${1}__close ${3:btn}\" type=\"button\" data-modal-close>",
      "      ${4:Close}",
      "    </button>",
      "    <h2 class=\"${5:text-h2}\" id=\"${2}-title\">${6:Title}</h2>",
      "    ${0}",
      "  </div>",
      "</div>",
    ],
  },
  "Frontend Burger": {
    "scope": "html",
    "prefix": "fe-burger",
    "description": "Insert burger button",
    "body": [
      "<button class=\"${1:burger}\" type=\"button\" aria-label=\"${2:Open menu}\" data-menu-button>",
      "  <span class=\"${1}__line\" aria-hidden=\"true\"></span>",
      "</button>",
    ],
  },
  "Frontend Nav": {
    "scope": "html",
    "prefix": "fe-nav",
    "description": "Insert navigation",
    "body": [
      "<nav class=\"${1:nav}\" aria-label=\"${2:Main navigation}\">",
      "  <a class=\"${1}__link is-active\" href=\"${3:#}\">${4:Link}</a>",
      "  <a class=\"${1}__link\" href=\"${5:#}\">${6:Link}</a>",
      "</nav>",
    ],
  },
  "Frontend SCSS Component": {
    "scope": "scss",
    "prefix": "fe-scss-component",
    "description": "Insert SCSS component skeleton",
    "body": [
      "@use \"${1:../fluid}\" as *;",
      "@use \"${2:../vars}\" as *;",
      "",
      ".${3:block} {",
      "  ${0}",
      "}",
    ],
  },
  "Frontend SCSS Media": {
    "scope": "scss",
    "prefix": "fe-media",
    "description": "Insert media query",
    "body": ["@media (max-width: ${1:$breakpoint-mobile}) {", "  ${0}", "}"],
  },
  "Frontend rem": {
    "scope": "scss",
    "prefix": "fe-rem",
    "description": "Insert rem helper",
    "body": ["rem(${1:16px})"],
  },
  "Frontend fluid": {
    "scope": "scss",
    "prefix": "fe-fluid",
    "description": "Insert fluid helper",
    "body": ["fluid(${1:16px}, ${2:32px})"],
  },
  "Frontend fluid property": {
    "scope": "scss",
    "prefix": "fe-fluid-prop",
    "description": "Insert fluid property mixin",
    "body": ["@include fluid-prop(${1:font-size}, ${2:16px}, ${3:32px});"],
  },
  "Frontend JS Component Init": {
    "scope": "javascript",
    "prefix": "fe-js-init",
    "description": "Insert JS init function",
    "body": [
      "export function init${1:Component}() {",
      "  const elements = document.querySelectorAll('[data-${2:component}]');",
      "",
      "  if (!elements.length) {",
      "    return;",
      "  }",
      "",
      "  elements.forEach((element) => {",
      "    ${0}",
      "  });",
      "}",
    ],
  },
}
